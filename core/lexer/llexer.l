%{
/* 
 * This section contains C code that is copied directly into the generated
 * lexer source file. It's used for declarations, helper functions, and
 * including necessary headers.
 */

// The pparser.tab.h header is generated by Bison and contains the token definitions.
// It's included here to ensure the lexer and parser agree on token codes.
#include "../parser/pparser.tab.h"
#include "../parser/pparser.tab.c" 
#include <stdlib.h> // Required for malloc, strdup, etc.
#include <string.h> // Required for string manipulation functions like strdup.

/*
 * Note: This lexer is now configured for use with a Bison parser.
 * Token values are passed via the 'yylval' union. It is assumed that
 * the Bison grammar file defines a 'sval' field in the YYSTYPE union
 * for string-like values (e.g., %union { char *sval; }).
 * All constants and identifiers are passed as strings.
 *
 * MEMORY MANAGEMENT: This lexer uses strdup() to copy token text.
 * strdup() allocates memory that must be freed later to prevent memory leaks.
 * The Bison parser is responsible for freeing the memory for each token's sval
 * once it is no longer needed.
 */

// Global variables to track the position in the source file for error reporting.
int line_num = 1;
int col_num = 1;

// This function updates the column and line numbers based on the matched token text.
// It is called before returning a token to ensure the position is always current.
void count_position() {
    for (int i = 0; yytext[i] != '\0'; i++) {
        if (yytext[i] == '\n') {
            line_num++;
            col_num = 1;
        } else {
            col_num++;
        }
    }
}

%}

/* 
 * Flex options to configure the generated scanner.
 * noyywrap: Makes the scanner stop when it reaches the end of the file,
 *           rather than looking for a yywrap() function to open another file.
 * yylineno: Tells Flex to automatically track the current line number in the
 *           global variable 'yylineno'. While we use a custom 'line_num',
 *           this can be useful for debugging.
 */
%option noyywrap
%option yylineno

/* 
 * Regular expression definitions. These are shorthand names for common
 * patterns, making the main rules section cleaner and more readable.
 */
/* D for a single digit */
D               [0-9]
/* L for a letter or underscore, the start of an identifier */
L               [a-zA-Z_]
/* H for a hexadecimal digit */
H               [a-fA-F0-9]
/* E for scientific notation exponent */
E               ([Ee][+-]?{D}+)
/* P for hexadecimal floating-point exponent */
P               ([Pp][+-]?{D}+)
/* FS for a floating-point suffix (f, F, l, L) */
FS              (f|F|l|L)
/* IS for an integer suffix (u, l, ll, combinations) */
IS              ((u|U)|(u|U)?(l|L|ll|LL)|(l|L|ll|LL)(u|U))

/* Whitespace characters to be ignored by the lexer. */
WS              [ \t\v\f]

%%
"/*"            {
                  int c;
                  while ((c = input()) != 0) {
                      if (c == '\n') {
                          line_num++;
                          col_num = 1;
                      } else {
                          col_num++;
                      }
                      if (c == '*') {
                          if ((c = input()) == '/') {
                              col_num++;
                              break;
                          } else {
                              unput(c);
                          }
                      }
                  }
                }
"//".*          { /* C++-style comment, ignored */ }
"auto"          { count_position(); return AUTO; }
"break"         { count_position(); return BREAK; }
"case"          { count_position(); return CASE; }
"char"          { count_position(); return CHAR; }
"const"         { count_position(); return CONST; }
"continue"      { count_position(); return CONTINUE; }
"default"       { count_position(); return DEFAULT; }
"do"            { count_position(); return DO; }
"double"        { count_position(); return DOUBLE; }
"else"          { count_position(); return ELSE; }
"enum"          { count_position(); return ENUM; }
"extern"        { count_position(); return EXTERN; }
"float"         { count_position(); return FLOAT; }
"for"           { count_position(); return FOR; }
"goto"          { count_position(); return GOTO; }
"if"            { count_position(); return IF; }
"inline"        { count_position(); return INLINE; }
"int"           { count_position(); return INT; }
"long"          { count_position(); return LONG; }
"register"      { count_position(); return REGISTER; }
"restrict"      { count_position(); return RESTRICT; }
"return"        { count_position(); return RETURN; }
"short"         { count_position(); return SHORT; }
"signed"        { count_position(); return SIGNED; }
"sizeof"        { count_position(); return SIZEOF; }
"static"        { count_position(); return STATIC; }
"struct"        { count_position(); return STRUCT; }
"switch"        { count_position(); return SWITCH; }
"typedef"       { count_position(); return TYPEDEF; }
"union"         { count_position(); return UNION; }
"unsigned"      { count_position(); return UNSIGNED; }
"void"          { count_position(); return VOID; }
"volatile"      { count_position(); return VOLATILE; }
"while"         { count_position(); return WHILE; }
"_Bool"         { count_position(); return _BOOL; }
"_Complex"      { count_position(); return _COMPLEX; }
"_Imaginary"    { count_position(); return _IMAGINARY; }
t|f|true|false  { count_position(); return BOOL_LITERAL; }
{L}({L}|{D})*   { count_position(); yylval.sval = strdup(yytext); return IDENTIFIER; }
0[xX]{H}+{IS}?          { count_position(); yylval.sval = strdup(yytext); return INTEGER_CONSTANT; }
0[0-7]*{IS}?            { count_position(); yylval.sval = strdup(yytext); return INTEGER_CONSTANT; }
[1-9]{D}*{IS}?          { count_position(); yylval.sval = strdup(yytext); return INTEGER_CONSTANT; }
{D}+{E}{FS}?            { count_position(); yylval.sval = strdup(yytext); return FLOATING_CONSTANT; }
{D}*\.{D}+{E}?{FS}?    { count_position(); yylval.sval = strdup(yytext); return FLOATING_CONSTANT; }
{D}+\.{D}*{E}?{FS}?    { count_position(); yylval.sval = strdup(yytext); return FLOATING_CONSTANT; }
0[xX]{H}+{P}{FS}?       { count_position(); yylval.sval = strdup(yytext); return FLOATING_CONSTANT; }
0[xX]{H}*\.{H}+{P}{FS}?    { count_position(); yylval.sval = strdup(yytext); return FLOATING_CONSTANT; }
0[xX]{H}+\.{H}*{P}{FS}?    { count_position(); yylval.sval = strdup(yytext); return FLOATING_CONSTANT; }

"..."           { count_position(); return ELLIPSIS; }
">>="           { count_position(); return RIGHT_ASSIGN; }
"<<="           { count_position(); return LEFT_ASSIGN; }
"+="            { count_position(); return ADD_ASSIGN; }
"-="            { count_position(); return SUB_ASSIGN; }
"*="            { count_position(); return MUL_ASSIGN; }
"/="            { count_position(); return DIV_ASSIGN; }
"%="            { count_position(); return MOD_ASSIGN; }
"&="            { count_position(); return AND_ASSIGN; }
"^="            { count_position(); return XOR_ASSIGN; }
"|="            { count_position(); return OR_ASSIGN; }
">>"            { count_position(); return RIGHT_SHIFT; }
"<<"            { count_position(); return LEFT_SHIFT; }
"++"            { count_position(); return INC_OP; }
"--"            { count_position(); return DEC_OP; }
"->"            { count_position(); return ARROW; }
"&&"            { count_position(); return AND_OP; }
"||"            { count_position(); return OR_OP; }
"<="            { count_position(); return LE_OP; }
">="            { count_position(); return GE_OP; }
"=="            { count_position(); return EQ_OP; }
"!="            { count_position(); return NE_OP; }
";"             { count_position(); return ';'; }
("{"|"<%")      { count_position(); return '{'; }
("}"|"%>")      { count_position(); return '}'; }
","             { count_position(); return ','; }
":"             { count_position(); return ':'; }
"="             { count_position(); return '='; }
"("             { count_position(); return '('; }
")"             { count_position(); return ')'; }
("["|"<:")      { count_position(); return '['; }
("]"|":>")      { count_position(); return ']'; }
"."             { count_position(); return '.'; }
"&"             { count_position(); return '&'; }
"!"             { count_position(); return '!'; }
"~"             { count_position(); return '~'; }
"-"             { count_position(); return '-'; }
"+"             { count_position(); return '+'; }
"*"             { count_position(); return '*'; }
"/"             { count_position(); return '/'; }
"%"             { count_position(); return '%'; }
"<"             { count_position(); return '<'; }
">"             { count_position(); return '>'; }
"^"             { count_position(); return '^'; }
"|"             { count_position(); return '|'; }
"?"             { count_position(); return '?'; }
^{WS}*"#"{WS}*  { count_position(); return HASH; }
"##"            { count_position(); return DOUBLE_HASH; }
{WS}+           { count_position(); }
\n              { line_num++; col_num = 1; }
.               { count_position(); fprintf(stderr, "Line %d, Col %d: Unknown character '%s'\n", line_num, col_num, yytext); }
%%
